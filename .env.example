ALGOLIA_APP_ID=your_app_id
ALGOLIA_SEARCH_API_KEY=your_search_only_api_key
ALGOLIA_ADMIN_API_KEY=your_admin_api_key
ALGOLIA_INDEX_NAME=restaurants

# Browser-exposed mirrors for the Next.js front-end (search-only key only -
# see lib/algolia.ts). Same values as above, just re-declared with the
# NEXT_PUBLIC_ prefix Next.js requires to inline a var into client bundles.
NEXT_PUBLIC_ALGOLIA_APP_ID=your_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your_search_only_api_key
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=restaurants
